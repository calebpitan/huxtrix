{
  "$schema": "https://turborepo.com/schema.json",
  "globalEnv": ["NODE_ENV", "LOG_LEVEL", "LOG_SERVICE", "DATABASE_URL", "SERVER_EMAIL_ADDRESS", "BASE_URL", "VERCEL_URL"],
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "cache": false
    },
    "build:watch": {
      "cache": false,
      "persistent": true
    },
    "brl": {
      "outputs": [],
      "cache": false
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "lint:fix": {
      "dependsOn": ["^lint:fix"],
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
