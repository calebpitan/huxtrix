{
  "name": "huxtrix",
  "private": true,
  "scripts": {
    "build": "yarn g:build",
    "brl": "yarn g:brl",
    "dev": "turbo run dev",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "g:brl": "turbo --filter \"./packages/**\" brl",
    "g:build": "turbo --filter \"./packages/**\" build",
    "g:lint": "turbo run lint",
    "g:lint:fix": "turbo run lint:fix",
    "g:typecheck": "turbo typecheck",
    "p:brl": "bash scripts/brl.sh",
    "p:build": "cd $INIT_CWD && tsc",
    "p:lint": "cd $INIT_CWD eslint --color",
    "p:lint:fix": "cd $INIT_CWD eslint --color --fix",
    "p:typecheck": "cd $INIT_CWD && tsc -p $INIT_CWD/tsconfig.json",
    "lint": "yarn g:lint",
    "lint:fix": "yarn g:lint:fix",
    "typecheck": "yarn g:typecheck",
    "ds:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "ds:migrate": "drizzle-kit migrate --config=drizzle.config.ts"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/postcss": "^4",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "barrelsby": "^2.8.1",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9",
    "eslint-config-next": "15.3.2",
    "prettier": "^3.6.0",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwindcss": "^4",
    "turbo": "^2.5.4",
    "tw-animate-css": "^1.2.9",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "yarn@4.6.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "devtools/*"
  ],
  "dependencies": {
    "next-auth": "^5.0.0-beta.29"
  }
}
