{
  "name": "@hux/eslint",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "A package to share ESLint configurations in workspace",
  "exports": {
    "./base": {
      "types": "base.d.ts",
      "default": "./base.js"
    },
    "./libs": {
      "types": "libs.d.ts",
      "default": "./libs.js"
    },
    "./next-js": {
      "types": "next.d.ts",
      "default": "./next.js"
    },
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@next/eslint-plugin-next": "^15.3.0",
    "eslint": "^9.30.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-only-warn": "^1.1.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-turbo": "^2.5.0",
    "globals": "^16.2.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.35.0"
  }
}
